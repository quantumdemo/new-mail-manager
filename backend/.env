# Flask Configuration
FLASK_SECRET_KEY=your_flask_secret_key_here

# Google OAuth Configuration
# Path to your Google client_secrets.json file
GOOGLE_CLIENT_SECRETS_FILE=client_secrets.json

# Microsoft OAuth Configuration
MS_CLIENT_ID=your_microsoft_client_id_here
MS_CLIENT_SECRET=your_microsoft_client_secret_here
MS_TENANT_ID=common

# Frontend URL for CORS (e.g., http://localhost:5173 or your production domain)
FRONTEND_URL=http://localhost:5173
